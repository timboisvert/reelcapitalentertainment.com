---
layout: base.njk
permalink: /media-kit/
title: Media kit
description: The official Reel Capital Entertainment logos, colors and deck, ready to download.
---
{# The downloadable files are listed in lib/logo.js and written to public/media/ by `bun run logos`. #}

{% set tiles = { white: "border border-ink/15 bg-white", black: "bg-ink" } %}

<section>
    <div class="wrap pb-16 pt-14 sm:pt-20 lg:pb-24">
        <h1 class="display-lg">Media kit</h1>
        <div class="mt-10 grid gap-8 md:grid-cols-12">
            <div class="md:col-span-7 lg:col-span-6">
                <p class="text-xl leading-snug sm:text-2xl">
                    The official {{ site.name }} logo and deck, for anyone writing about us or working with us.
                    Download what you need below.
                </p>
                <p class="mt-8 text-lg"><a href="/media/{{ logo.zip }}" download class="link">Download everything (.zip)</a></p>
            </div>
        </div>
    </div>
</section>

{# ---------- The files ---------- #}
{% for group in logo.kit %}
<section class="border-t border-ink">
    <div class="wrap grid gap-x-8 gap-y-8 py-12 lg:grid-cols-12 lg:py-16">
        <div class="lg:col-span-3">
            <h2 class="font-display text-4xl leading-none">{{ group.title }}</h2>
            <p class="mt-4 max-w-sm leading-snug text-ink/70">{{ group.note }}</p>
        </div>
        <ul class="grid gap-x-6 gap-y-10 sm:grid-cols-3 lg:col-span-9">
            {% for item in group.items %}
            {% set preview = "png" if "svg" not in item.formats else "svg" %}
            <li>
                <div class="flex aspect-[4/3] items-center justify-center p-8 {{ tiles[item.on] }}">
                    <img src="/media/{{ item.file }}.{{ preview }}" alt="{{ site.name }} {{ group.title | lower }}, {{ item.label | lower }}" loading="lazy" class="max-h-full max-w-[72%] object-contain">
                </div>
                <p class="mt-3 font-medium">{{ item.label }}</p>
                <p class="mt-1 flex gap-x-6 text-sm">
                    {% for format in item.formats %}
                    <a href="/media/{{ item.file }}.{{ format }}" download class="link">Download {{ format | upper }}</a>
                    {% endfor %}
                </p>
            </li>
            {% endfor %}
        </ul>
    </div>
</section>
{% endfor %}

{# ---------- The deck: built from the site's content on every build (lib/deck.js) ---------- #}
<section class="border-t border-ink">
    <div class="wrap grid gap-x-8 gap-y-8 py-12 lg:grid-cols-12 lg:py-16">
        <div class="lg:col-span-3">
            <h2 class="font-display text-4xl leading-none">Deck</h2>
            <p class="mt-4 max-w-sm leading-snug text-ink/70">Who we are, how we work, what we look for and the projects we have backed, as a PDF to send on. It is rebuilt whenever the site changes, so it is always current.</p>
        </div>
        <div class="lg:col-span-9">
            <a href="/media/{{ logo.deck }}" class="group block max-w-2xl" aria-label="Open the {{ site.name }} deck (PDF)">
                <div class="flex aspect-video flex-col justify-between border border-ink/15 bg-white p-[5%]">
                    <p class="font-display text-[clamp(1.6rem,7.2vw,4.6rem)] font-black leading-[0.82]">Investing in<br>the business of<br>entertainment.</p>
                    <div>{{ logo.full("h-[clamp(2.25rem,9vw,5rem)] w-auto") | safe }}</div>
                </div>
            </a>
            <p class="mt-3 font-medium">{{ site.name }} deck</p>
            <p class="mt-1 flex gap-x-6 text-sm">
                <a href="/media/{{ logo.deck }}" download class="link">Download PDF</a>
                <a href="/media/{{ logo.deck }}" target="_blank" rel="noopener" class="link">Open in browser</a>
            </p>
        </div>
    </div>
</section>

{# ---------- Colors ---------- #}
<section class="border-t border-ink">
    <div class="wrap grid gap-x-8 gap-y-8 py-12 lg:grid-cols-12 lg:py-16">
        <div class="lg:col-span-3">
            <h2 class="font-display text-4xl leading-none">Colors</h2>
            <p class="mt-4 max-w-sm leading-snug text-ink/70">Hex and RGB are for screens. CMYK and Pantone are the closest matches for print.</p>
        </div>
        <ul class="grid gap-x-6 gap-y-8 sm:grid-cols-3 lg:col-span-9">
            {% for color in logo.colors %}
            <li>
                <div class="aspect-[4/3] border border-ink/15" style="background:{{ color.hex }}"></div>
                <p class="mt-3 font-medium">{{ color.name }}</p>
                <dl class="mt-2 border-b border-ink/20 text-sm">
                    <div class="grid grid-cols-[4.5rem_1fr] gap-3 border-t border-ink/20 py-1.5"><dt class="text-ink/60">Hex</dt><dd class="uppercase">{{ color.hex }}</dd></div>
                    <div class="grid grid-cols-[4.5rem_1fr] gap-3 border-t border-ink/20 py-1.5"><dt class="text-ink/60">RGB</dt><dd>{{ color.rgb }}</dd></div>
                    <div class="grid grid-cols-[4.5rem_1fr] gap-3 border-t border-ink/20 py-1.5"><dt class="text-ink/60">CMYK</dt><dd>{{ color.cmyk }}</dd></div>
                    {% if color.pantone %}<div class="grid grid-cols-[4.5rem_1fr] gap-3 border-t border-ink/20 py-1.5"><dt class="text-ink/60">Pantone</dt><dd>{{ color.pantone }}</dd></div>{% endif %}
                </dl>
            </li>
            {% endfor %}
        </ul>
    </div>
</section>

{# ---------- Using the logo ---------- #}
<section class="border-t border-ink">
    <div class="wrap grid gap-x-8 gap-y-8 py-12 lg:grid-cols-12 lg:py-16">
        <h2 class="font-display text-4xl leading-none lg:col-span-3">Using the logo</h2>
        <ul class="lg:col-span-9">
            <li class="border-t border-ink/20 py-4 text-lg leading-snug">Use the files as they are. Please don't stretch, redraw or retype the logo.</li>
            <li class="border-t border-ink/20 py-4 text-lg leading-snug">Black, white or red only. On dark backgrounds and photographs, use the white one.</li>
            <li class="border-t border-ink/20 py-4 text-lg leading-snug">Leave clear space around it, at least the height of the word CAPITAL.</li>
            <li class="border-y border-ink/20 py-4 text-lg leading-snug">
                Need a different size or format?
                {% if site.email %}<a href="mailto:{{ site.email }}" class="link">{{ site.email }}</a>{% else %}Call <a href="tel:+1{{ site.phone | replace('-', '') }}" class="link">{{ site.phone }}</a>.{% endif %}
            </li>
        </ul>
    </div>
</section>
