---
permalink: /logos/
---
{# The logo options side by side, for choosing one. Delete this page once a logo is picked. #}

{% macro icons(v, tile) %}
<span class="grid h-[64px] w-[64px] place-items-center text-[64px] {{ tile }}">{{ v.icon() | safe }}</span>
<span class="grid h-[32px] w-[32px] place-items-center text-[32px] {{ tile }}">{{ v.icon() | safe }}</span>
<span class="grid h-[16px] w-[16px] place-items-center text-[16px] {{ tile }}">{{ v.icon() | safe }}</span>
{% endmacro %}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Logo options | {{ site.name }}</title>
    <meta name="robots" content="noindex">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <main class="wrap pb-28 pt-12 lg:pt-16">
        <h1 class="display-lg">Logo options</h1>
        <p class="mt-6 max-w-2xl text-lg leading-snug">
            {{ logo.variants.length }} options. Each is one flat color, so it works in black, white or red, and each
            is shown at the sizes a website really uses. Every option also has its own copy of the site.
        </p>

        <section class="mt-12 border-t border-ink pt-6">
            <div class="grid gap-x-8 gap-y-6 lg:grid-cols-12">
                <h2 class="font-display text-4xl leading-none lg:col-span-3">The reel</h2>
                <div class="flex flex-wrap gap-x-14 gap-y-8 lg:col-span-9">
                    {% for r in logo.reels %}
                    <figure>{{ r.svg | safe }}<figcaption class="mt-3 text-sm text-ink/70">{{ r.label }}</figcaption></figure>
                    {% endfor %}
                </div>
            </div>
        </section>

        {% for v in logo.variants %}
        {% set small = 'text-[1.3rem]' if v.stacked else 'text-[1.9rem]' %}
        <section class="mt-16 border-t border-ink pt-6 lg:mt-24" data-option="{{ v.id }}">
            <div class="grid gap-x-8 gap-y-3 lg:grid-cols-12">
                <h2 class="font-display text-4xl leading-none lg:col-span-3">{{ v.letter }}. {{ v.title }}</h2>
                <div class="lg:col-span-9">
                    <p class="max-w-2xl leading-snug text-ink/70">{{ v.note }}</p>
                    <p class="mt-3"><a href="{{ v.path }}" class="link">See the site with logo {{ v.letter }}</a></p>
                </div>
            </div>

            {# Large, on white #}
            <div class="mt-8 flex items-center justify-center overflow-hidden border border-ink/15 px-6 py-16 text-[2.75rem] sm:text-[5rem] lg:py-24 lg:text-[7.5rem]">
                {{ v.lockup(false) | safe }}
            </div>

            {# On the site's colors #}
            <div class="mt-4 grid gap-4 md:grid-cols-2">
                <div class="flex items-center justify-center overflow-hidden bg-ink px-6 py-12 text-[2.4rem] text-white sm:text-[3.5rem]">{{ v.lockup(false) | safe }}</div>
                <div class="flex items-center justify-center overflow-hidden bg-accent px-6 py-12 text-[2.4rem] text-white sm:text-[3.5rem]">{{ v.lockup(false) | safe }}</div>
            </div>

            {# Small: the size it is in the site header, in black and in red #}
            <div class="mt-4 border border-ink/15">
                <p class="px-5 pt-3 text-xs text-ink/50">Small, the size it is at the top of the site: in black and in red</p>
                <div class="mt-3 grid border-t border-ink/15 sm:grid-cols-2">
                    <div class="flex h-14 items-center px-5 {{ small }}">{{ v.lockup(true) | safe }}</div>
                    <div class="flex h-14 items-center border-t border-ink/15 px-5 text-accent sm:border-l sm:border-t-0 {{ small }}">{{ v.lockup(true) | safe }}</div>
                </div>
                <div class="grid border-t border-ink/15 sm:grid-cols-2">
                    <div class="flex h-14 items-center bg-ink px-5 text-white {{ small }}">{{ v.lockup(true) | safe }}</div>
                    <div class="flex h-14 items-center bg-accent px-5 text-white {{ small }}">{{ v.lockup(true) | safe }}</div>
                </div>
            </div>

            {# Smallest: app and browser-tab icons #}
            <div class="mt-4 border border-ink/15">
                <p class="px-5 pt-3 text-xs text-ink/50">As an icon at 64, 32 and 16 pixels: on black, on red, and in black and red on white</p>
                <div class="flex flex-wrap items-center gap-x-10 gap-y-4 px-5 pb-4 pt-3">
                    <span class="flex items-center gap-4">{{ icons(v, "bg-ink text-white") }}</span>
                    <span class="flex items-center gap-4">{{ icons(v, "bg-accent text-white") }}</span>
                    <span class="flex items-center gap-4">{{ icons(v, "border border-ink/20") }}</span>
                    <span class="flex items-center gap-4">{{ icons(v, "border border-ink/20 text-accent") }}</span>
                </div>
            </div>
        </section>
        {% endfor %}
    </main>

    {% include "switch.njk" %}
</body>
</html>
